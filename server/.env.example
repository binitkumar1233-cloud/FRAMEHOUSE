PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/video_platform
JWT_SECRET=change_this_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Razorpay webhook (Dashboard > Settings > Webhooks, events: payment.captured, order.paid, payment.failed)
# URL: https://<your-api>/api/subscription/webhook
RAZORPAY_WEBHOOK_SECRET=

# Local testing only: built-in test checkout when Razorpay keys fail. Remove in production.
ALLOW_DEMO_PAYMENTS=false

# Emails (confirmation, invoice, reminders). Without SMTP_HOST, emails are saved to server/outbox/.
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=Framehouse <no-reply@your-domain.com>
SUPPORT_EMAIL=support@example.com
APP_URL=http://localhost:5173

# ---- Sign-in security (new browser / device / IP / city -> emailed code) ----
# OTP codes are emailed with the SMTP_* settings above (saved to server/outbox/ without SMTP).
# OTP_TTL_MINUTES=10          how long a code is valid
# OTP_MAX_ATTEMPTS=5          wrong guesses before the code is locked
# OTP_RESEND_SECONDS=30       wait between "resend code" requests
# OTP_MAX_RESENDS=3           resends allowed per sign-in
# TRUSTED_DEVICE_DAYS=30      default time a trusted browser skips the code (users can pick 7 / 30 / 90)
# MAX_FAILED_LOGINS=8         failed passwords per email in 15 minutes before sign-in is paused
# LOGIN_HISTORY_DAYS=365      how long sign-in history is kept
# GEOIP_DISABLED=false        true turns off IP -> city lookups (uses the free ip-api.com service)
# TRUST_PROXY=true            REQUIRED behind a proxy / load balancer so the real client IP is recorded

# ---- Video playback ----
WATCH_COMPLETION_PERCENT=95 # percent watched before a video is marked complete (1-100)

# ---- Comments ----
# TRANSLATE_PROVIDER=mymemory       free MyMemory API (no key). "mock" gives fake translations for offline work.
# MYMEMORY_EMAIL=you@example.com    optional; raises MyMemory's free daily limit
# COMMENT_EDIT_MINUTES=15           how long authors can edit or delete their own comment
# COMMENT_RATE_PER_MINUTE=5         hard limit per user
# COMMENT_RATE_PER_HOUR=40
# COMMENT_CAPTCHA_AFTER_BLOCKED=3   blocked attempts (10 min) before a CAPTCHA is required
# COMMENT_CAPTCHA_AFTER_BURST=3     posts in the last minute before a CAPTCHA is required
# COMMENT_BLOCKED_WORDS=word1,word2 extra words to block, on top of the built-in list
# COMMENT_BLOCKED_DOMAINS=bad.com   extra blocked link domains

# SMS for sign-in codes (Twilio). Leave empty to save texts to server/outbox instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or use TWILIO_MESSAGING_SERVICE_SID instead of TWILIO_FROM
TWILIO_MESSAGING_SERVICE_SID=
